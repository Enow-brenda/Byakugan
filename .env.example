# ─── Groq (LLM generation + optional query routing) ───────────────────────────
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the generation model.
# Default: openai/gpt-oss-120b
# (llama-3.3-70b-versatile was retired from Groq's catalogue; list what your key
#  can reach with: curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY")
# LLM_MODEL=openai/gpt-oss-120b

# Optional: how hard the model reasons before answering (low|medium|high).
# Reasoning tokens are billed against max_completion_tokens, so keep this low to
# leave room for the JSON payload on large batches.
# LLM_REASONING_EFFORT=low

# Optional: cap output tokens per call (default: 16000, provider max: 32768)
# Raise this if a pass reports finish_reason=length.
# LLM_MAX_COMPLETION_TOKENS=16000

# ─── Hugging Face (embeddings for RAG chat) ────────────────────────────────────
# Get your free token at: https://huggingface.co/settings/tokens ("Read" is enough)
HF_API_KEY=your_hf_token_here

# Optional: override the embedding model.
# Default: BAAI/bge-small-en-v1.5  (384 dims, returned L2-normalized)
# Note: sentence-transformers/all-MiniLM-L6-v2 is served as a sentence-similarity
# pipeline by the router and returns scores, not vectors — it cannot build an index.
# EMBED_MODEL=BAAI/bge-small-en-v1.5

# Optional: override the HF endpoint. The legacy api-inference.huggingface.co
# host no longer resolves, so the router is the default.
# HF_BASE_URL=https://router.huggingface.co/hf-inference/models

# ─── Network resilience ───────────────────────────────────────────────────────
# Per-request timeout in milliseconds (default: 120000)
# LLM_TIMEOUT_MS=120000

# Retry attempts for 429 / 5xx / socket errors (default: 4)
# DNS failures are NOT retried — they cannot succeed on a second attempt.
# LLM_MAX_ATTEMPTS=4

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Byakugan paces its own calls against a mirrored rolling window instead of
# hammering the API and collecting 429s. Groq's free tier allows roughly 8,000
# tokens/minute per organization, so that is the default. When a batch does not
# fit, the CLI shows a live countdown until the window frees up.
#
# A paid Groq "Dev" tier raises this ceiling — set LLM_TPM_LIMIT to match your
# plan or every pass will wait on a limit the provider is not actually imposing.
# LLM_TPM_LIMIT=8000

# ─── Analysis budgets (override via CLI flags --max-files / --max-chars) ──────
# Hard ceiling on files analyzed (default: 800)
# MAX_FILES=800

# Hard ceiling on content characters sent to the LLM (default: 1500000)
# MAX_CONTENT_CHARS=1500000

# Characters per file-batch request (default: 16000, ~5,300 tokens).
# Kept well under the per-minute ceiling so a normal run never has to wait; a
# larger codebase raises the batch count, not the per-request size.
# Lower it if you raise nothing else and still hit 413/429 on a single pass.
# BATCH_CHAR_BUDGET=16000

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development

# Characters per second that streamed answers (explain / impact / chat) are
# revealed at (default: 40). The model usually returns a whole answer in under a
# second, so without pacing the text simply appears; ~40 chars/s is about a
# comfortable reading pace. Set 0 to turn pacing off and print as fast as the
# provider delivers. Only applies to interactive terminals: piped output and
# --raw always print immediately.
# BYAKUGAN_REVEAL_CPS=40
