# ─── Groq (LLM generation + query routing) ────────────────────────────────────
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the generation model (default: llama-3.3-70b-versatile)
# LLM_MODEL=llama-3.3-70b-versatile

# ─── Hugging Face (embeddings for RAG chat) ────────────────────────────────────
# Get your free token at: https://huggingface.co/settings/tokens
HF_API_KEY=your_hf_token_here

# Optional: override the embedding model (default: sentence-transformers/all-MiniLM-L6-v2)
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
