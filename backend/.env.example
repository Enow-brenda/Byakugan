# ─── Byakugan backend ───────────────────────────────────────────────────────
# This file belongs to backend/ ONLY. It is the one place provider credentials
# exist, and it is never published to npm.
#
# The CLI in package/ has no keys and no .env: it points at this service.
#
#   cp backend/.env.example backend/.env      then fill it in
#   npm run dev -w @byakugan/server            or: node backend/src/index.js

NODE_ENV=development
PORT=8787
HOST=0.0.0.0

# ─── Shared secret ──────────────────────────────────────────────────────────
# Optional in development. REQUIRED in production: without it anyone who finds
# the URL can spend this account.
#
# Be clear about what this is. It ships inside the published npm package, which
# means anyone can read it. It is a speed bump and an abuse meter, not a security
# boundary. What actually limits spend is that this server only accepts a fixed
# list of named tasks (see src/tasks.js) and renders the prompts itself — a
# client cannot ask for arbitrary completions.
#
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BYAKUGAN_API_TOKEN=paste-a-long-random-string-here

# ─── Groq (generation + query routing) ──────────────────────────────────────
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Default: openai/gpt-oss-120b
# LLM_MODEL=openai/gpt-oss-120b

# low | medium | high — reasoning tokens are billed against max_completion_tokens,
# so keep this low to leave room for the JSON payload on large batches.
# LLM_REASONING_EFFORT=low

# Default 16000, provider max 32768. Raise if a pass reports finish_reason=length.
# LLM_MAX_COMPLETION_TOKENS=16000

# ─── Hugging Face (embeddings for RAG chat) ─────────────────────────────────
# A "Read" token is enough: https://huggingface.co/settings/tokens
HF_API_KEY=your_hf_token_here

# Default: BAAI/bge-small-en-v1.5 (384 dims, returned L2-normalized)
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# HF_BASE_URL=https://router.huggingface.co/hf-inference/models

# ─── Rate limiting ──────────────────────────────────────────────────────────
# Now SHARED across every client, which is the point of running a backend. The
# CLI used to hold this ledger in its own process, so N concurrent installs each
# believed they owned the whole allowance and the org overran its Groq tier.
# Groq's free tier allows roughly 8,000 tokens/minute per organization.
# LLM_TPM_LIMIT=8000

# Optional per-tenant caps. Set BYAKUGAN_API_TOKEN on the client and these are
# keyed by that token; an unauthenticated client is counted as "anonymous" and
# therefore shares one allowance.
# BYAKUGAN_TOKEN_TPM_LIMIT=20000
# BYAKUGAN_MAX_TOKENS_PER_DAY=5000000

# ─── Network resilience ────────────────────────────────────────────────────
# LLM_TIMEOUT_MS=120000
# LLM_MAX_ATTEMPTS=4

# ─── Request guards ────────────────────────────────────────────────────────
# A batch is ~16k characters, so 1 MB is generous. The cap is what stops one
# client from pinning memory on a small host and taking everyone down with it.
# BYAKUGAN_MAX_BODY_BYTES=1048576
# BYAKUGAN_MAX_EMBED_INPUTS=256

# ─── Mock mode ─────────────────────────────────────────────────────────────
# Answers every task with a deterministic fixture, so the CLI and this backend
# can be exercised end to end with no keys and no spend. Not a model: it proves
# the protocol, not the analysis.
#
# Refused when NODE_ENV=production unless BYAKUGAN_ALLOW_MOCK is also set, because
# a mock build in production looks healthy and quietly returns invented analysis.
# BYAKUGAN_MOCK=true
# BYAKUGAN_ALLOW_MOCK=true

# error | warn | info | debug
# BYAKUGAN_LOG_LEVEL=info
